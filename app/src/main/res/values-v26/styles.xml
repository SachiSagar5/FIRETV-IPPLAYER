<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 26+ can load bundled font resources. Pre-26 falls back to the
         system sans-serif (which is Roboto on Fire OS anyway). -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/roboto_family</item>
        <item name="android:colorAccent">#E50914</item>
        <item name="android:windowBackground">#101114</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#101114</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
