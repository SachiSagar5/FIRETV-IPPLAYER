<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 26+ can load bundled font resources. Pre-26 falls back to the
         system sans-serif (which is Roboto on Fire OS anyway). -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/roboto_family</item>
        <item name="android:colorAccent">@color/brand_red</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/navigation_black</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
