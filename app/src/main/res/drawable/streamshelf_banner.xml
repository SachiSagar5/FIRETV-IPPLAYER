<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Fire TV / Android TV Banner (320x180dp)
  Replace this with a 320x180 PNG file named streamshelf_banner.png in drawable-xhdpi/ for best results
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101114" />
        </shape>
    </item>
    <!-- Left accent panel -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17191E" />
        </shape>
    </item>
    <!-- Red accent bar -->
    <item android:left="0dp" android:right="170dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#E50914" />
        </shape>
    </item>
    <!-- Play triangle (white) centered in red area -->
    <item android:left="40dp" android:right="240dp" android:top="50dp" android:bottom="50dp">
        <rotate android:fromDegrees="0" android:toDegrees="0">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFF" />
            </shape>
        </rotate>
    </item>
    <!-- "IPTV" text representation -->
    <item android:left="180dp" android:top="50dp" android:bottom="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#E50914" />
        </shape>
    </item>
    <item android:left="180dp" android:top="70dp" android:bottom="70dp">
        <shape android:shape="rectangle">
            <solid android:color="#E50914" />
        </shape>
    </item>
    <item android:left="180dp" android:top="90dp" android:bottom="90dp">
        <shape android:shape="rectangle">
            <solid android:color="#41434A" />
        </shape>
    </item>
    <item android:left="180dp" android:top="110dp" android:bottom="110dp">
        <shape android:shape="rectangle">
            <solid android:color="#41434A" />
        </shape>
    </item>
</layer-list>